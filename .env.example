# Kalshi Quant Multi-Strategy Engine Configuration
# Non-negotiable endpoints:
# Demo REST: https://demo-api.kalshi.co/trade-api/v2
# Prod REST: https://external-api.kalshi.com/trade-api/v2

KALSHI_ENV=DEMO
TRADING_MODE=PAPER

# RSA Key Credentials (RSA-PSS with SHA256)
KALSHI_KEY_ID=your_key_id_here
KALSHI_PRIVATE_KEY_PATH=kalshi_ecdsa_or_rsa.pem
# Alternatively provide pem string:
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."

# External Feeds
THE_ODDS_API_KEY=your_the_odds_api_key_here

# Telegram Control & Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Database & Sync
DUCKDB_PATH=data/kalshi_quant.duckdb
FIREBASE_CREDENTIALS_PATH=
BIGQUERY_PROJECT_ID=

# Server
API_HOST=127.0.0.1
API_PORT=8000

# ============================================================================
# STANDALONE 24/7 CRYPTO QUANT MACHINE (100% Isolated from Kalshi Sports Cash)
# ============================================================================
# 1. Hyperliquid Wallet + Trade-Only "API Agent Wallet" (Cannot withdraw funds!)
HYPERLIQUID_WALLET_ADDRESS=0xYourMainWalletAddressHere
HYPERLIQUID_AGENT_PRIVATE_KEY=0xYourTradeOnlyAgentPrivateKeyHere

# 2. Kraken Pro Trade-Only API Key (Leave "Withdraw Funds" UNCHECKED!)
KRAKEN_API_KEY=your_kraken_pro_api_key_here
KRAKEN_API_SECRET=your_kraken_pro_api_secret_here

# 3. Stolen-Phone Protection PIN (Blocks anyone holding your unlocked phone from clicking action buttons)
DASHBOARD_ACTION_PIN=your_secret_6_digit_pin_here
