---
---

<div class="quant-card p-5">
  <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="font-bold text-white text-base">Nightly 3:00 AM BigQuery Grader</h3>
        <span class="rounded bg-purple-500/20 px-2 py-0.5 text-[10px] font-bold text-purple-400 border border-purple-500/30">
          BRIER SCORE &amp; CLV SELF-LEARNING
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-0.5">Automated statistical calibration vs sharp Pinnacle closing lines</p>
    </div>
    <div class="text-right">
      <span class="text-xs text-slate-400 block">Overall Grade</span>
      <span class="font-bold text-emerald-400 text-sm">A+ (Elite Edge)</span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs">
    <!-- Pod 1 Grade -->
    <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-800">
      <div class="flex justify-between items-center mb-2">
        <span class="font-sans font-semibold text-white">Pod 1: Maker Momentum</span>
        <span class="rounded bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 text-[10px] font-bold">Grade A</span>
      </div>
      <div class="space-y-1.5 text-slate-300">
        <div class="flex justify-between">
          <span class="text-slate-400">Brier Score:</span>
          <span class="text-white font-bold">0.142 (Target &lt; 0.18)</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Average CLV:</span>
          <span class="text-emerald-400 font-bold">+3.8% Beat Closing Line</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Guillotine Precision:</span>
          <span class="text-cyan-400 font-bold">92.5% Panic Filter</span>
        </div>
      </div>
    </div>

    <!-- Pod 2 Grade -->
    <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-800">
      <div class="flex justify-between items-center mb-2">
        <span class="font-sans font-semibold text-white">Pod 2: Sharp Value Green-Out</span>
        <span class="rounded bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 text-[10px] font-bold">Grade A+</span>
      </div>
      <div class="space-y-1.5 text-slate-300">
        <div class="flex justify-between">
          <span class="text-slate-400">Green-Out Win Rate:</span>
          <span class="text-emerald-400 font-bold">100.0% Equalized</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Average Locked Gain:</span>
          <span class="text-white font-bold">+17.4¢ per contract</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Pre-Game Edge:</span>
          <span class="text-indigo-400 font-bold">+6.1¢ vs Vegas Vig</span>
        </div>
      </div>
    </div>

    <!-- Pod 3 Grade -->
    <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-800">
      <div class="flex justify-between items-center mb-2">
        <span class="font-sans font-semibold text-white">Pod 3: Tail-Lock Harvester</span>
        <span class="rounded bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 text-[10px] font-bold">Grade A+</span>
      </div>
      <div class="space-y-1.5 text-slate-300">
        <div class="flex justify-between">
          <span class="text-slate-400">Tail-Lock Accuracy:</span>
          <span class="text-emerald-400 font-bold">99.8% (0 False Positives)</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Harvest Yield:</span>
          <span class="text-white font-bold">+4.3% in &lt; 2 minutes</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Brier Score:</span>
          <span class="text-cyan-400 font-bold">0.008 (Near-Perfect)</span>
        </div>
      </div>
    </div>
  </div>
</div>
