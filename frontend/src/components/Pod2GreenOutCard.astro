---
---

<div class="quant-card p-5">
  <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="font-bold text-white text-base">Pod 2: Sharp Value & Mid-Game Green Out</h3>
        <span class="rounded bg-cyan-500/20 px-2 py-0.5 text-[10px] font-bold text-cyan-400 border border-cyan-500/30">
          +16¢ EQUAL PROFIT LOCK
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-0.5">Pre-game 38¢-58¢ entries (Vegas edge &gt;= 5¢) • Automatic mid-game equalized profit</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Opportunity Active</span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Position Status -->
    <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-800">
      <span class="text-xs text-slate-400 block mb-1">Active Match & Position</span>
      <h4 class="font-semibold text-white text-sm">Detroit Lions vs Green Bay Packers</h4>
      <div class="mt-2 space-y-1 font-mono text-xs">
        <div class="flex justify-between text-slate-300">
          <span>Contracts Held:</span>
          <span class="font-bold text-white">25 YES</span>
        </div>
        <div class="flex justify-between text-slate-300">
          <span>Pre-Game Entry:</span>
          <span class="text-indigo-400">42¢ (Circa Prob: 51.5%)</span>
        </div>
        <div class="flex justify-between text-slate-300">
          <span>Live YES Bid:</span>
          <span class="font-bold text-emerald-400 text-sm">59¢ (+17¢ Gain!)</span>
        </div>
      </div>
    </div>

    <!-- Green Out Formula Calculation -->
    <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-800">
      <span class="text-xs text-slate-400 block mb-1">Guaranteed Equal Profit Math</span>
      <div class="space-y-1.5 font-mono text-xs mt-1">
        <div class="flex justify-between text-slate-300">
          <span>Formula:</span>
          <span class="text-amber-400 font-semibold">Q × (P_curr - P_0)</span>
        </div>
        <div class="flex justify-between text-slate-300">
          <span>Contracts to Sell:</span>
          <span class="text-white">25 contracts @ 59¢</span>
        </div>
        <div class="flex justify-between text-slate-300">
          <span>Guaranteed Return:</span>
          <span class="font-bold text-emerald-400">+$4.25 (Both States)</span>
        </div>
        <div class="flex justify-between text-slate-300">
          <span>Taker Fee:</span>
          <span class="text-emerald-400 font-bold">$0.00 (Resting Maker)</span>
        </div>
      </div>
    </div>

    <!-- Action Execution Trigger -->
    <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-800 flex flex-col justify-between">
      <div>
        <span class="text-xs text-slate-400 block mb-1">Threshold Trigger</span>
        <div class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/20 px-2.5 py-1 text-xs font-semibold text-emerald-300 border border-emerald-500/30">
          ⚡ +17¢ Gain (&gt;= +16¢ Target)
        </div>
        <p class="text-[11px] text-slate-400 mt-2">Opening drive touchdown scored. Locks equal guaranteed profit whether Lions win or lose.</p>
      </div>

      <button id="btn-trigger-pod2-green" class="mt-3 w-full rounded-md bg-emerald-600 hover:bg-emerald-500 px-3 py-2 text-xs font-bold text-white shadow-md shadow-emerald-900/40 transition">
        Execute Green Out Now (+ $4.25 Locked)
      </button>
    </div>
  </div>
</div>
