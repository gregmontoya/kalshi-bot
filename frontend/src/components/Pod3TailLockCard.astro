---
---

<div class="quant-card p-5">
  <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="font-bold text-white text-base">Pod 3: 4th-Quarter Tail-Lock Harvester</h3>
        <span class="rounded bg-amber-500/20 px-2 py-0.5 text-[10px] font-bold text-amber-400 border border-amber-500/30">
          PROBABILITY &gt;= 99.2% LOCK
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-0.5">Scans 95¢-97¢ contracts • ESPN Hidden Scoreboard physics & kneel-down clock math</p>
    </div>
    <div class="text-right">
      <span class="text-xs text-slate-400 block">ESPN Sync</span>
      <span class="font-mono text-xs font-semibold text-emerald-400">Live • 1.2s Latency</span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Game State -->
    <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-800">
      <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
        <span class="font-bold uppercase tracking-wider text-amber-400">Q4 • 01:15</span>
        <span class="rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-300">NFL Live</span>
      </div>
      <div class="flex justify-between items-center mb-1">
        <span class="font-bold text-white text-sm">Kansas City Chiefs</span>
        <span class="font-mono font-bold text-emerald-400 text-lg">27</span>
      </div>
      <div class="flex justify-between items-center text-slate-400 mb-3">
        <span class="text-sm">Denver Broncos</span>
        <span class="font-mono text-slate-300 text-lg">17</span>
      </div>
      <div class="border-t border-slate-800 pt-2 space-y-1 font-mono text-[11px] text-slate-400">
        <div class="flex justify-between">
          <span>Possession:</span>
          <span class="text-white font-semibold">Chiefs (1st & 10)</span>
        </div>
        <div class="flex justify-between">
          <span>Denver Timeouts:</span>
          <span class="text-rose-400 font-semibold">0 Timeouts Left</span>
        </div>
      </div>
    </div>

    <!-- Clock / Physics Math -->
    <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-800">
      <span class="text-xs text-slate-400 block mb-2 font-semibold">Mathematical Kneel-Down Proof</span>
      <div class="space-y-1.5 font-mono text-xs text-slate-300">
        <div class="flex justify-between">
          <span>Regulation Seconds Left:</span>
          <span class="text-white font-bold">75 seconds</span>
        </div>
        <div class="flex justify-between">
          <span>Available Kneels:</span>
          <span class="text-white font-bold">3 kneel-downs</span>
        </div>
        <div class="flex justify-between">
          <span>Max Clock Burn:</span>
          <span class="text-amber-400 font-bold">120 seconds (3 × 40s)</span>
        </div>
        <div class="flex justify-between border-t border-slate-800 pt-1.5">
          <span>Mathematical Certainty:</span>
          <span class="text-emerald-400 font-bold">100.0% (Clock cannot stop)</span>
        </div>
      </div>
    </div>

    <!-- Contract Harvesting Status -->
    <div class="bg-slate-900/60 rounded-lg p-3.5 border border-slate-800 flex flex-col justify-between">
      <div>
        <span class="text-xs text-slate-400 block mb-1">Resting Harvest Order</span>
        <div class="flex items-baseline gap-2">
          <span class="font-mono text-xl font-bold text-white">96¢ Bid</span>
          <span class="text-xs text-slate-400">50 contracts ($48.00)</span>
        </div>
        <div class="mt-2 text-xs space-y-1 text-slate-300">
          <p>• Guaranteed Payout: <span class="font-mono font-bold text-white">$50.00</span></p>
          <p>• Free Premium Harvested: <span class="font-mono font-bold text-emerald-400">+$2.00 (4.1% in 75s)</span></p>
          <p>• Downside Risk: <span class="text-emerald-400 font-semibold">Zero (Clock runs out on knee)</span></p>
        </div>
      </div>

      <div class="mt-3">
        <span class="w-full inline-flex items-center justify-center rounded bg-emerald-500/20 px-3 py-1.5 text-xs font-bold text-emerald-300 border border-emerald-500/30">
          ✓ Resting Maker Harvest Active
        </span>
      </div>
    </div>
  </div>
</div>
