---
---

<div class="quant-card p-5">
  <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="font-bold text-white text-base">Open-Meteo Stadium Weather &amp; Wind</h3>
        <span class="rounded bg-sky-500/20 px-2 py-0.5 text-[10px] font-bold text-sky-400 border border-sky-500/30">
          MICRO-CLIMATE SCANNER
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-0.5">High wind velocity and freezing impact on outdoor scoring scripts</p>
    </div>
    <div class="text-right">
      <span class="text-xs text-slate-400 block">Venue</span>
      <span class="font-bold text-white text-xs">GEHA Field at Arrowhead</span>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center font-mono text-xs">
    <div class="bg-slate-900/60 rounded-lg p-3 border border-slate-800">
      <span class="text-slate-400 block text-[11px] mb-1">Temperature</span>
      <span class="text-lg font-bold text-white">48°F</span>
      <span class="text-[10px] text-slate-400 block mt-0.5">Clear / Cold</span>
    </div>

    <div class="bg-slate-900/60 rounded-lg p-3 border border-slate-800">
      <span class="text-slate-400 block text-[11px] mb-1">Sustained Wind</span>
      <span class="text-lg font-bold text-amber-400">14.2 mph</span>
      <span class="text-[10px] text-slate-400 block mt-0.5">Moderate Crosswind</span>
    </div>

    <div class="bg-slate-900/60 rounded-lg p-3 border border-slate-800">
      <span class="text-slate-400 block text-[11px] mb-1">Wind Gusts</span>
      <span class="text-lg font-bold text-rose-400">22.8 mph</span>
      <span class="text-[10px] text-rose-400 block mt-0.5">FG Penalty Active</span>
    </div>

    <div class="bg-slate-900/60 rounded-lg p-3 border border-slate-800">
      <span class="text-slate-400 block text-[11px] mb-1">Dome Status</span>
      <span class="text-lg font-bold text-emerald-400">Open Air</span>
      <span class="text-[10px] text-slate-400 block mt-0.5">Real Weather Play</span>
    </div>
  </div>
</div>
