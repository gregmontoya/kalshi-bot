---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Kalshi Quant Multi-Strategy Trading Engine & Real-Time Dashboard" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#080c14" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#080c14] text-slate-100 antialiased selection:bg-emerald-500/30 selection:text-emerald-300">
    <slot />
  </body>
</html>
